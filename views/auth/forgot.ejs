<%- include('../partials/head') %>
<body>
<%- include('../partials/auth-theme-toggle') %>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-side">
      <div class="logo">
        <img src="/static/img/Pylox_no_bg.png" alt="<%= siteName %>" style="object-fit:contain;border-radius:8px">
        <span><%= siteName %></span>
      </div>
      <h2><%= t('auth.forgot.title') %></h2>
      <p class="subtitle"><%= t('auth.forgot.subtitle') %></p>
    </div>
    <div class="auth-main">
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (sent) { %>
        <div class="alert alert-success"><%= t('auth.forgot.sentMessage') %></div>
      <% } %>
      <form method="POST" action="/auth/forgot-password">
        <div class="form-group">
          <label><%= t('common.email') %></label>
          <input type="email" name="email" placeholder="<%= t('common.emailPlaceholder') %>" required autofocus>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%"><%= t('auth.forgot.submit') %></button>
      </form>
      <p class="switch"><%= t('auth.forgot.remember') %> <a href="/auth/login"><%= t('auth.register.signIn') %></a></p>
    </div>
  </div>
</div>
</body></html>
