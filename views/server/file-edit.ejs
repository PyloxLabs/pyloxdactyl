<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%
  var _base = (filePath.split('/').pop() || '').toLowerCase();
  var _ext = (_base.indexOf('.') > -1 ? _base.split('.').pop() : '').toLowerCase();
  var _langMap = {
    js: 'javascript', mjs: 'javascript', cjs: 'javascript', jsx: 'jsx',
    ts: 'typescript', tsx: 'tsx', json: 'json',
    html: 'markup', htm: 'markup', xml: 'markup', svg: 'markup', vue: 'markup',
    css: 'css', scss: 'scss', less: 'less',
    md: 'markdown', markdown: 'markdown',
    yml: 'yaml', yaml: 'yaml',
    ini: 'ini', cfg: 'ini', conf: 'ini', properties: 'properties',
    toml: 'toml', env: 'bash',
    sh: 'bash', bash: 'bash', zsh: 'bash',
    py: 'python', java: 'java',
    c: 'c', h: 'c', cpp: 'cpp', cc: 'cpp', cxx: 'cpp', hpp: 'cpp', hxx: 'cpp',
    cs: 'csharp', sql: 'sql', go: 'go', rb: 'ruby', php: 'php', pl: 'perl',
    lua: 'lua', rs: 'rust', ps1: 'powershell', bat: 'batch', cmd: 'batch',
    dockerfile: 'docker', nginx: 'nginx', mk: 'makefile'
  };
  var language = _langMap[_ext] || 'plain';
  if (_base === 'dockerfile') language = 'docker';
  if (_base === 'makefile') language = 'makefile';
%>
<div class="server-shell">
<div class="main-content">
  <div class="page-wrapper">
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:8px">
      <a href="/dashboard" style="color:var(--text-muted);font-size:14px;text-decoration:none"><%= t('common.dashboard') %></a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted)"><polyline points="9 18 15 12 9 6"/></svg>
      <a href="/server/<%= server.id %>/files?dir=<%= encodeURIComponent(filePath.split('/').slice(0,-1).join('/') || '/') %>" data-edit-back-to-files style="color:var(--text-muted);font-size:14px;text-decoration:none"><%= t('server.tabs.files') %></a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted)"><polyline points="9 18 15 12 9 6"/></svg>
      <span style="font-size:14px;font-weight:600"><%= filePath %></span>
    </div>
    <%- include('_tabs', { active: 'files' }) %>
    <form method="POST" action="/server/<%= server.id %>/files/edit" id="file-edit-form">
      <input type="hidden" name="path" value="<%= filePath %>">
      <div style="margin-bottom:12px;display:flex;gap:8px;align-items:center">
        <span style="font-size:13px;color:var(--text-muted)"><%= filePath %></span>
        <div style="margin-left:auto;display:flex;gap:8px;align-items:center">
          <span id="save-status" style="font-size:12px;color:var(--text-muted);opacity:0;transition:opacity 0.3s"></span>
          <a href="/server/<%= server.id %>/files?dir=<%= encodeURIComponent(filePath.split('/').slice(0,-1).join('/') || '/') %>" id="cancel-edit" data-navigate-dir class="btn btn-ghost btn-sm"><%= t('common.cancel') %></a>
          <button type="submit" class="btn btn-primary btn-sm"><%= t('common.save') %></button>
        </div>
      </div>
      <pre class="code-editor language-<%= language %>" id="code-editor-wrap" data-file-path="<%= filePath %>" data-language="<%= language %>"><code id="file-editor" spellcheck="false"></code></pre>
      <textarea name="content" id="file-content" style="display:none"><%= content %></textarea>
    </form>
  </div>
</div>
<div id="autosave-spinner"></div>
<script>
(function () {
  var serverId = <%= server.id %>;
  var language = '<%= language %>';
  var form = document.getElementById('file-edit-form');
  var initialEl = document.getElementById('file-content');
  var editorEl = document.getElementById('file-editor');
  var editorWrap = document.getElementById('code-editor-wrap');
  var filePath = editorWrap ? (editorWrap.getAttribute('data-file-path') || '') : '';
  var status = document.getElementById('save-status');
  var spinner = document.getElementById('autosave-spinner');
  var shell = form ? form.closest('.server-shell') : null;
  var jar = null;

  function loadScript(src) {
    return new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      s.src = src;
      s.onload = resolve;
      s.onerror = function () { reject(new Error(src)); };
      document.head.appendChild(s);
    });
  }

  window.__pyloxAssets = window.__pyloxAssets || Promise.all([
    window.Prism ? Promise.resolve() : loadScript('/static/js/vendor/prism.js'),
    window.CodeJar ? Promise.resolve() : loadScript('/static/js/vendor/codejar.js')
  ]);

  window.__pyloxAssets.then(function () {
    if (!editorEl || !window.CodeJar || !window.Prism) return;
    var codeVal = initialEl ? initialEl.value : '';
    editorEl.textContent = codeVal;
    var highlight = function (el) {
      var code = el.textContent;
      var grammar = window.Prism.languages[language] || window.Prism.languages.plain || {};
      try { el.innerHTML = window.Prism.highlight(code, grammar, language || 'plain'); } catch (e) { el.textContent = code; }
    };
    jar = window.CodeJar(editorEl, highlight, { tab: '  ', spellcheck: false });
    if (codeVal) jar.updateCode(codeVal);
    else highlight(editorEl);
  }).catch(function () {
    if (editorEl) {
      editorEl.textContent = initialEl ? initialEl.value : '';
      editorEl.setAttribute('contenteditable', 'true');
    }
  });

  function getCode() {
    return jar ? jar.toString() : (initialEl ? initialEl.value : '');
  }

  function setSaving(on) {
    if (!spinner) return;
    if (on) spinner.classList.add('visible');
    else spinner.classList.remove('visible');
  }

  function showStatus(text) {
    if (!status) return;
    status.textContent = text;
    status.style.opacity = '1';
    clearTimeout(status._t);
    status._t = setTimeout(function () { status.style.opacity = '0'; }, 2000);
  }

  function saveFile(cb) {
    setSaving(true);
    fetch('/server/' + serverId + '/files/edit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ path: filePath, content: getCode() }),
      credentials: 'same-origin'
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.ok) showStatus('<%= t('server.files.saveSuccess') %>');
        else showStatus('<%= t('server.files.saveError') %>');
      })
      .catch(function () {
        showStatus('<%= t('server.files.saveError') %>');
      })
      .finally(function () { setSaving(false); });
  }

  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      saveFile();
    });
  }

  document.addEventListener('keydown', function (e) {
    if (!(e.ctrlKey || e.metaKey) || (e.key !== 's' && e.key !== 'S')) return;
    if (!shell || !shell.isConnected || shell.classList.contains('is-hidden')) return;
    e.preventDefault();
    saveFile();
  });

})();
</script>
</div>
</body></html>