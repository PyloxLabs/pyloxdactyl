<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="main-content">
  <div class="page-wrapper">
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:8px">
      <a href="/dashboard" style="color:var(--text-muted);font-size:14px;text-decoration:none"><%= t('common.dashboard') %></a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted)"><polyline points="9 18 15 12 9 6"/></svg>
      <a href="/server/<%= server.id %>" style="color:var(--text-muted);font-size:14px;text-decoration:none"><%= server.name %></a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted)"><polyline points="9 18 15 12 9 6"/></svg>
      <span style="font-size:14px;font-weight:600"><%= t('server.terminal.title') %></span>
    </div>
    <div class="card" style="padding:0;overflow:hidden">
      <div id="terminal" style="background:#0a0a0c;padding:16px;font-family:Consolas,'Courier New',monospace;font-size:13px;line-height:1.7;height:500px;overflow-y:auto;color:#a1a1aa;white-space:pre-wrap"></div>
      <div style="padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px">
        <input type="text" id="term-input" placeholder="<%= t('server.terminal.placeholder') %>" style="flex:1;padding:8px 12px;background:var(--surface);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:monospace;font-size:13px;outline:none" autofocus>
        <button onclick="sendTerm()" class="btn btn-primary btn-sm"><%= t('common.send') %></button>
      </div>
    </div>
  </div>
</div>
<script>
const term = document.getElementById('terminal');
const input = document.getElementById('term-input');
const uuid = '<%= server.uuid %>';
const ws = new WebSocket(`${location.protocol === 'https:' ? 'wss:' : 'ws:'}//${location.host}/ws/console?server=${uuid}`);
ws.onopen = () => { term.textContent += window.t('server.terminal.connected'); };
ws.onmessage = (e) => { term.textContent += e.data + '\n'; term.scrollTop = term.scrollHeight; };
function sendTerm() { if (input.value.trim()) { ws.send(input.value); input.value = ''; } }
input.addEventListener('keydown', e => { if (e.key === 'Enter') { sendTerm(); e.preventDefault(); } });
</script>
</body></html>