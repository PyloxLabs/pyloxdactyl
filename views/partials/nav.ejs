<script>
(() => {
  const btn = document.getElementById('nav-avatar-btn');
  const dropside = document.getElementById('user-dropside');
  const overlay = document.getElementById('user-dropside-overlay');
  if (!btn || !dropside || !overlay) return;
  const themeBtn = document.getElementById('user-dropside-theme');
  let lastFocus = null;

  const getFocusables = () => Array.from(dropside.querySelectorAll('a[href], button:not([disabled]), select:not([tabindex="-1"]), [tabindex]:not([tabindex="-1"])'))
    .filter((el) => el.getClientRects().length > 0);

  const syncTheme = () => {
    if (!themeBtn) return;
    const dark = document.documentElement.getAttribute('data-theme') !== 'light';
    themeBtn.setAttribute('aria-checked', dark ? 'true' : 'false');
    if (window.t) {
      themeBtn.title = window.t(dark ? 'nav.darkMode' : 'nav.lightMode');
    }
  };

  const open = () => {
    if (dropside.classList.contains('active')) return;
    lastFocus = document.activeElement;
    dropside.classList.add('active');
    overlay.classList.add('active');
    dropside.setAttribute('aria-hidden', 'false');
    syncTheme();
    const focusables = getFocusables();
    if (focusables.length) focusables[0].focus();
  };

  const close = () => {
    if (!dropside.classList.contains('active')) return;
    dropside.classList.remove('active');
    overlay.classList.remove('active');
    dropside.setAttribute('aria-hidden', 'true');
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  };

  btn.addEventListener('click', open);
  overlay.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  dropside.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusables = getFocusables();
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  const mobileBtn = document.getElementById('mobile-account-btn');
  if (mobileBtn) {
    mobileBtn.addEventListener('click', () => {
      const menu = document.querySelector('.mobile-menu');
      const menuOverlay = document.querySelector('.mobile-menu-overlay');
      if (menu) menu.classList.remove('active');
      if (menuOverlay) menuOverlay.classList.remove('active');
      open();
    });
  }

  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      if (typeof window.toggleTheme === 'function') window.toggleTheme();
      syncTheme();
    });
    if (window.MutationObserver) {
      new MutationObserver(syncTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme']
      });
    }
  }

  const langSel = document.getElementById('user-menu-lang');
  if (langSel) {
    langSel.addEventListener('change', async () => {
      const prev = "<%= (user && user.language) || 'en' %>";
      try {
        const res = await fetch('/account/language', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ language: langSel.value })
        });
        let body = {};
        try { body = await res.json(); } catch (e) {}
        if (!res.ok || !body.ok) throw new Error(body.error || 'failed');
        window.location.reload();
      } catch (e) {
        langSel.value = prev;
      }
    });
  }
})();
</script>
<script>
(() => {
  // The reflection overlay is masked with the logo itself, so it only paints
  // on the icon's opaque pixels instead of the whole square around it.
  document.querySelectorAll('.nav .nav-logo-media[data-logo]').forEach((media) => {
    const logo = media.getAttribute('data-logo');
    if (logo) media.style.setProperty('--logo-url', `url(${JSON.stringify(logo)})`);
  });
})();
</script>
<script>
(() => {
  const list = document.querySelector('.nav-links');
  if (!list) return;
  const pill = document.createElement('div');
  pill.className = 'nav-hover-pill';
  list.appendChild(pill);
  let active = list.querySelector('a.active');
  let target = null;

  // Keep the accent color on whichever link the pill currently covers so the
  // color travels at the same time as the animated square.
  const setTarget = (el) => {
    if (target === el) return;
    if (target) target.classList.remove('pill-target');
    target = el;
    if (target) target.classList.add('pill-target');
  };

  const moveTo = (el) => {
    setTarget(el);
    pill.style.transform = `translate(-50%, ${el.offsetTop}px)`;
    list.classList.add('pill-visible');
  };
  const restAt = () => {
    if (active) moveTo(active);
    else {
      setTarget(null);
      list.classList.remove('pill-visible');
    }
  };

  restAt();

  list.addEventListener('mouseover', (e) => {
    const link = e.target.closest('a');
    if (link && list.contains(link)) moveTo(link);
  });

  list.addEventListener('mouseleave', restAt);
})();
</script>



