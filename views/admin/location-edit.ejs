<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="main-content">
  <div class="page-wrapper">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px">
      <a href="/admin/locations" style="color:var(--text-muted);font-size:14px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></a>
      <h1 style="font-size:24px"><%= t('admin.locationEdit.title', { long: loc.long }) %></h1>
    </div>
    <%- include('_tabs') %>
    <div style="margin-top:20px"></div>
    <div class="grid-2">
      <form method="POST" action="/admin/locations/<%= loc.id %>">
        <div class="card">
          <h3 style="font-size:16px;font-weight:600;margin-bottom:16px"><%= t('admin.locationEdit.detailsTitle') %></h3>
          <div class="form-group"><label><%= t('common.shortCode') %></label><input type="text" name="short" value="<%= loc.short %>" required></div>
          <div class="form-group"><label><%= t('common.fullName') %></label><input type="text" name="long" value="<%= loc.long %>" required></div>
          <button type="submit" class="btn btn-primary"><%= t('common.saveChanges') %></button>
        </div>
      </form>
      <div class="card">
        <h3 style="font-size:16px;font-weight:600;margin-bottom:16px"><%= t('admin.locationEdit.nodesCount', { count: nodes.length }) %></h3>
        <% if (nodes.length === 0) { %>
          <div class="empty"><h3><%= t('admin.locationEdit.emptyTitle') %></h3><p><%= t('admin.locationEdit.emptyText') %></p></div>
        <% } else { %>
          <div style="display:flex;flex-direction:column;gap:8px">
            <% nodes.forEach(n => { %>
              <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)">
                <div>
                  <a href="/admin/nodes/<%= n.id %>" style="font-weight:600;color:var(--accent)"><%= n.name %></a>
                  <div style="font-size:11px;color:var(--text-muted)"><%= t('admin.locationEdit.nodeMeta', { fqdn: n.fqdn, count: n.server_count }) %></div>
                </div>
                <svg class="ecg-svg" width="18" height="14" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="vertical-align:-1px;color:#22c55e;margin-left:0">
    <defs><clipPath id="heart-clip-loc"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></clipPath></defs>
    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" stroke="currentColor" stroke-width="1.5"/>
    <g clip-path="url(#heart-clip-loc)"><polyline points="-4,11 4,11 6,8 8,14 10,11 28,11" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="ecg-line"></polyline></g>
  </svg>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
</body></html>