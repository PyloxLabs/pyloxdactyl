<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="main-content">
  <div class="page-wrapper">
    <div class="page-header" style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
      <div>
        <h1><%= ext.name %></h1>
        <p><%= ext.description || t('admin.extensions.noDescription') %></p>
      </div>
      <a href="/admin/extensions" class="btn btn-ghost btn-sm">&larr; <%= t('admin.extensions.backToList') %></a>
    </div>
    <%- include('_tabs') %>

    <% if (notice) { %><div class="alert alert-success" style="margin-bottom:20px"><%= notice %></div><% } %>
    <% if (ext.error) { %><div class="alert alert-error" style="margin-bottom:20px"><%= t('admin.extensions.loadError') %> <%= ext.error %></div><% } %>

    <div class="ext-detail">
      <div class="ext-detail-meta">
        <div class="ext-detail-icon">
          <% if (ext.icon) { %>
            <img src="/extensions/<%= ext.id %>/<%= ext.icon %>" alt="" onerror="this.style.display='none'">
          <% } else { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/></svg>
          <% } %>
        </div>
        <div class="ext-detail-rows">
          <div><span><%= t('admin.extensions.fieldId') %></span><code><%= ext.id %></code></div>
          <div><span><%= t('admin.extensions.fieldVersion') %></span><strong>v<%= ext.version %></strong></div>
          <div><span><%= t('admin.extensions.fieldAuthor') %></span><strong><%= ext.author || t('common.na') %></strong></div>
          <div>
            <span><%= t('common.status') %></span>
            <% if (ext.enabled) { %><span class="badge badge-green"><%= t('admin.extensions.statusEnabled') %></span>
            <% } else { %><span class="badge badge-gray"><%= t('admin.extensions.statusDisabled') %></span><% } %>
          </div>
        </div>
        <form method="POST" action="/admin/extensions/<%= ext.id %>/toggle">
          <button class="btn <%= ext.enabled ? 'btn-ghost' : 'btn-primary' %> btn-sm" style="width:100%"><%= ext.enabled ? t('admin.extensions.disable') : t('admin.extensions.enable') %></button>
        </form>
      </div>

      <div class="ext-detail-settings">
        <h3><%= t('admin.extensions.settingsTitle') %></h3>
        <% if (!ext.settings_schema || ext.settings_schema.length === 0) { %>
          <p class="ext-detail-none"><%= t('admin.extensions.noSettings') %></p>
        <% } else { %>
          <form method="POST" action="/admin/extensions/<%= ext.id %>">
            <% ext.settings_schema.forEach(function (field) { %>
              <% var key = field.key; var type = field.type || 'text'; var val = ext.settings[key]; %>
              <div class="form-group">
                <label for="ext-<%= key %>"><%= field.label || key %></label>
                <% if (type === 'boolean') { %>
                  <label class="ext-toggle">
                    <input type="checkbox" id="ext-<%= key %>" name="<%= key %>" value="1" <%= (val === true || val === '1' || val === 'true' || val === 1) ? 'checked' : '' %>>
                    <span><%= field.hint || (field.label || key) %></span>
                  </label>
                <% } else if (type === 'select') { %>
                  <select id="ext-<%= key %>" name="<%= key %>">
                    <% (field.options || []).forEach(function (opt) {
                         var optVal = (opt && typeof opt === 'object') ? opt.value : opt;
                         var optLabel = (opt && typeof opt === 'object') ? (opt.label || opt.value) : opt; %>
                      <option value="<%= optVal %>" <%= String(val) === String(optVal) ? 'selected' : '' %>><%= optLabel %></option>
                    <% }); %>
                  </select>
                <% } else if (type === 'textarea') { %>
                  <textarea id="ext-<%= key %>" name="<%= key %>" rows="3" placeholder="<%= field.placeholder || '' %>"><%= (val === undefined || val === null) ? '' : val %></textarea>
                <% } else if (type === 'text' && key.endsWith('_redirect_uri')) { %>
                  <% var provider = key.replace('_redirect_uri', ''); var computed = (typeof baseUrl !== 'undefined' && baseUrl ? baseUrl : '') + '/auth/oauth/' + provider + '/callback'; %>
                  <input type="text" id="ext-<%= key %>" name="<%= key %>" value="<%= computed %>" readonly onclick="this.select(); if(window.copyToClipboard){window.copyToClipboard(this.value,'Copied');}">
                  <p class="ext-field-hint"><%= t('admin.extensions.redirectHint') || ('Copy this redirect URI to your ' + provider + ' OAuth application') %></p>
                <% } else { %>
                  <input type="<%= type %>" id="ext-<%= key %>" name="<%= key %>"
                    value="<%= (type === 'password') ? '' : ((val === undefined || val === null) ? '' : val) %>"
                    placeholder="<%= type === 'password' ? t('admin.settings.keepCurrentPlaceholder') : (field.placeholder || '') %>">
                <% } %>
                <% if (field.hint && type !== 'boolean') { %><p class="ext-field-hint"><%= field.hint %></p><% } %>
              </div>
            <% }); %>
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:8px">
              <button type="submit" class="btn btn-primary"><%= t('common.saveChanges') %></button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<style>
.ext-detail { display: grid; grid-template-columns: 300px 1fr; gap: 32px; align-items: start; }
.ext-detail-meta {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  display: flex; flex-direction: column; gap: 18px;
}
.ext-detail-icon {
  width: 64px; height: 64px;
  border-radius: 14px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  color: var(--accent);
  overflow: hidden;
}
.ext-detail-icon img { width: 100%; height: 100%; object-fit: contain; }
.ext-detail-rows { display: flex; flex-direction: column; gap: 10px; font-size: 13px; }
.ext-detail-rows > div { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
.ext-detail-rows span { color: var(--text-muted); }
.ext-detail-rows code { background: var(--bg-secondary); padding: 2px 8px; border-radius: 6px; font-size: 12px; }
.ext-detail-settings {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px;
}
.ext-detail-settings h3 { font-size: 15px; font-weight: 600; margin-bottom: 20px; }
.ext-detail-none { font-size: 13px; color: var(--text-muted); }
.ext-field-hint { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
.ext-toggle { display: flex; align-items: center; gap: 10px; font-size: 13px; cursor: pointer; }
.ext-toggle input { width: auto; }
@media (max-width: 860px) {
  .ext-detail { grid-template-columns: 1fr; }
}
</style>
</body></html>
