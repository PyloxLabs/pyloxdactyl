<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="main-content">
  <div class="page-wrapper">
    <div class="page-header"><h1><%= t('admin.users.title') %></h1><p><%= t('admin.users.subtitle') %></p></div>
    <%- include('_tabs') %>
    <div style="display:flex;align-items:center;justify-content:space-between;margin:20px 0 16px">
      <form method="GET" action="/admin/users" style="display:flex;gap:8px">
        <input type="text" name="search" value="<%= search %>" placeholder="<%= t('admin.users.searchPlaceholder') %>" style="padding:8px 14px;background:var(--surface);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;outline:none;width:280px">
        <button class="btn btn-ghost btn-sm"><%= t('common.search') %></button>
      </form>
      <button onclick="var o=document.getElementById('create-user-modal'); if(o){ o.classList.remove('closing'); requestAnimationFrame(function(){ o.classList.add('active'); });; }" class="btn btn-primary btn-sm"><%= t('admin.users.createTitle') %></button>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th><%= t('common.id') %></th><th><%= t('common.username') %></th><th><%= t('common.email') %></th><th><%= t('common.admin') %></th><th><%= t('admin.users.createdHeader') %></th><th><%= t('common.actions') %></th></tr></thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.id %></td>
              <td><a href="/admin/users/<%= u.id %>" style="color:var(--accent)"><%= u.username %></a></td>
              <td><%= u.email %></td>
              <td><% if (u.root_admin) { %><span class="badge badge-purple"><%= t('common.admin') %></span><% } else { %><span class="badge badge-gray"><%= t('admin.users.userBadge') %></span><% } %></td>
              <td style="font-size:12px;color:var(--text-muted)"><%= new Date(u.created_at).toLocaleDateString() %></td>
              <td style="display:flex;gap:6px">
                <a href="/admin/users/<%= u.id %>" class="btn btn-ghost btn-sm"><%= t('common.edit') %></a>
                <% if (u.id !== user.id) { %>
                  <form method="POST" action="/admin/users/<%= u.id %>/delete" data-confirm="<%= t('admin.users.deleteConfirm') %>"><button class="btn btn-danger btn-sm"><%= t('common.delete') %></button></form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<div class="modal-overlay" id="create-user-modal">
  <div class="modal">
    <button class="modal-close" onclick="var o=this.closest('.modal-overlay'); if(o){ o.classList.add('closing'); setTimeout(function(){ o.classList.remove('active'); o.classList.remove('closing'); }, 300); }">&times;</button>
    <h3><%= t('admin.users.createTitle') %></h3>
    <form method="POST" action="/admin/users/create">
      <div class="form-group"><label><%= t('common.username') %></label><input type="text" name="username" required></div>
      <div class="form-group"><label><%= t('common.email') %></label><input type="email" name="email" required></div>
      <div class="form-group"><label><%= t('common.password') %></label><input type="password" name="password" required></div>
      <div class="form-group">
        <label class="checkbox-label"><span class="checkbox"><input type="checkbox" name="root_admin"><span class="checkbox-mark"></span></span> <%= t('common.rootAdministrator') %></label>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="var o=this.closest('.modal-overlay'); if(o){ o.classList.add('closing'); setTimeout(function(){ o.classList.remove('active'); o.classList.remove('closing'); }, 300); }"><%= t('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= t('admin.users.createTitle') %></button>
      </div>
    </form>
  </div>
</div>
</body></html>


