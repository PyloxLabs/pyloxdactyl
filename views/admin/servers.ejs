<%- include('../partials/head') %><%- include('../partials/nav') %><div class="main-content">  <div class="page-wrapper">    <div class="page-header"><h1><%= t('admin.servers.title') %></h1><p><%= t('admin.servers.subtitle') %></p></div>    <%- include('_tabs') %>    <% if (notice === 'provisioned') { %>      <div style="padding:10px 14px;border-radius:8px;background:rgba(34,197,94,0.12);color:#22c55e;font-size:13px;margin:12px 0"><%= t('admin.servers.noticeProvisioned') %></div>    <% } else if (notice && notice.indexOf('provisionfailed') === 0) { %>      <div style="padding:10px 14px;border-radius:8px;background:rgba(239,68,68,0.12);color:#ef4444;font-size:13px;margin:12px 0"><%= t('admin.servers.noticeProvisionFailed', { error: decodeURIComponent(notice.replace('provisionfailed:', '')) }) %></div>    <% } else if (notice && notice.indexOf('createfailed') === 0) { %>      <div style="padding:10px 14px;border-radius:8px;background:rgba(239,68,68,0.12);color:#ef4444;font-size:13px;margin:12px 0"><%= t('admin.servers.noticeCreateFailed', { error: decodeURIComponent(notice.replace('createfailed:', '')) }) %></div>    <% } %>    <div style="display:flex;align-items:center;justify-content:space-between;margin:20px 0 16px">      <form method="GET" action="/admin/servers" style="display:flex;gap:8px">        <input type="text" name="search" value="<%= search || '' %>" placeholder="<%= t('admin.servers.searchPlaceholder') %>" style="padding:8px 14px;background:var(--surface);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;outline:none;width:280px">        <button type="submit" class="btn btn-ghost btn-sm" style="padding:9px;line-height:0" title="<%= t('common.search') %>" aria-label="<%= t('common.search') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.65" y2="16.65"/></svg></button>      </form>            <button onclick="var o=document.getElementById('create-server-modal'); if(o){ o.classList.remove('closing'); requestAnimationFrame(function(){ o.classList.add('active'); }); }" class="btn btn-primary btn-sm"><%= t('admin.servers.createTitle') %></button>    </div>    <div class="table-wrap">      <table class="table">        <thead><tr><th><%= t('common.id') %></th><th><%= t('common.name') %></th><th><%= t('common.owner') %></th><th><%= t('common.node') %></th><th><%= t('common.egg') %></th><th><%= t('common.memory') %></th><th><%= t('common.disk') %></th><th><%= t('common.status') %></th><th><%= t('common.actions') %></th></tr></thead>        <tbody>          <% servers.forEach(s => { %>            <tr>              <td><%= s.id %></td>              <td><a href="/admin/servers/<%= s.id %>" style="color:var(--accent)"><%= s.name %></a></td>              <td><%= s.username || '-' %></td>              <td><%= s.node_name || 'N/A' %></td>              <td style="font-size:12px"><%= s.egg_name || '-' %></td>              <td><%= t('admin.servers.memoryCell', { memory: s.memory }) %></td>              <td><%= t('admin.servers.diskCell', { disk: s.disk }) %></td>              <td><span class="badge badge-<%= s.suspended ? 'orange' : (s.status === 'running' ? 'green' : (s.status === 'installing' || s.status === 'starting') ? 'yellow' : 'red') %>"><%= s.suspended ? t('common.suspended') : s.status %></span></td>              <td style="display:flex;gap:6px">                <a href="/admin/servers/<%= s.id %>" class="btn btn-ghost btn-sm"><%= t('common.manage') %></a>                <a href="/server/<%= s.id %>" class="btn btn-ghost btn-sm"><%= t('common.view') %></a>                <form method="POST" action="/admin/servers/<%= s.id %>/delete" style="display:inline" data-confirm="<%= t('admin.servers.deleteConfirm') %>"><button class="btn btn-danger btn-sm"><%= t('common.delete') %></button></form>              </td>            </tr>          <% }) %>        </tbody>      </table>    </div>  </div></div><div class="modal-overlay" id="create-server-modal">  <div class="modal" style="max-width:640px">    <button class="modal-close" onclick="var o=this.closest('.modal-overlay'); if(o){ o.classList.add('closing'); setTimeout(function(){ o.classList.remove('active'); o.classList.remove('closing'); }, 300); }">&times;</button>    <h3><%= t('admin.servers.createTitle') %></h3>    <form method="POST" action="/admin/servers/create">      <div class="grid-2">        <div class="form-group"><label><%= t('common.name') %></label><input type="text" name="name" placeholder="<%= t('admin.servers.namePlaceholder') %>" required></div>        <div class="form-group"><label><%= t('common.owner') %></label><select name="user_id"><% users.forEach(u => { %><option value="<%= u.id %>"><%= u.username %></option><% }) %></select></div>      </div>      <div class="grid-2">        <div class="form-group"><label><%= t('common.node') %></label><select name="node_id"><% nodes.forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %></select></div>        <div class="form-group"><label><%= t('common.allocation') %></label><select name="allocation_id"><option value=""><%= t('common.none') %></option><% allocations.forEach(a => { %><option value="<%= a.id %>"><%= a.ip %>:<%= a.port %> (<%= a.node_name %>)</option><% }) %></select></div>      </div>      <div class="form-group"><label>Egg</label>        <select name="egg_id">          <option value=""><%= t('admin.servers.selectEgg') %></option>          <% nests.forEach(nest => { %>            <optgroup label="<%= nest.name %>">              <% eggs.filter(e => e.nest_id === nest.id).forEach(e => { %>                <option value="<%= e.id %>"><%= e.name %></option>              <% }) %>            </optgroup>          <% }) %>          <% eggs.filter(e => !e.nest_id).forEach(e => { %>            <option value="<%= e.id %>"><%= e.name %></option>          <% }) %>        </select>      </div>      <div class="grid-2">                <div class="form-group"><label><%= t('common.startupCommand') %></label><textarea name="startup" rows="2" style="font-family:monospace"></textarea></div>
        <div class="form-group"><label><%= t('common.dockerImage') %></label><input type="text" name="image" placeholder="<%= t('admin.servers.imagePlaceholder') %>"></div>      </div>      <div class="grid-3">                <div class="form-group"><label><%= t('common.memoryMb') %></label><input type="number" name="memory" value="1024"></div>
        <div class="form-group"><label><%= t('common.swapMb') %></label><input type="number" name="swap" value="0"></div>
        <div class="form-group"><label><%= t('common.diskMb') %></label><input type="number" name="disk" value="10240"></div>      </div>      <div class="grid-3">                <div class="form-group"><label><%= t('common.cpuPercent') %></label><input type="number" name="cpu" value="100"></div>
        <div class="form-group"><label><%= t('admin.servers.ioLabel') %></label><input type="number" name="io" value="500"></div>
        <div class="form-group"><label><%= t('common.backupLimit') %></label><input type="number" name="backups_limit" value="3"></div>      </div>      <div class="grid-3">                <div class="form-group"><label><%= t('common.databaseLimit') %></label><input type="number" name="database_limit" value="0"></div>
        <div class="form-group"><label><%= t('common.allocationLimit') %></label><input type="number" name="allocation_limit" min="0" value="0"></div>
        <div class="form-group"><label><%= t('common.description') %></label><input type="text" name="description" placeholder="<%= t('common.optional') %>"></div>      </div>      <div class="modal-actions">                <button type="button" class="btn btn-ghost" onclick="var o=this.closest('.modal-overlay'); if(o){ o.classList.add('closing'); setTimeout(function(){ o.classList.remove('active'); o.classList.remove('closing'); }, 300); }"><%= t('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= t('admin.servers.createTitle') %></button>      </div>    </form>  </div></div></body></html>


