<%- include('../partials/head') %><%- include('../partials/nav') %><div class="main-content">  <div class="page-wrapper">    <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px">      <a href="/admin/users" style="color:var(--text-muted);font-size:14px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></a>      <h1 style="font-size:24px"><%= t('admin.userEdit.title', { username: editUser.username }) %></h1>    </div>    <%- include('_tabs') %>    <div style="margin-top:20px"></div>    <form method="POST" action="/admin/users/<%= editUser.id %>">      <div class="card" style="margin-bottom:20px">        <h3 style="font-size:16px;font-weight:600;margin-bottom:16px"><%= t('admin.userEdit.detailsTitle') %></h3>        <div class="grid-2">          <div class="form-group"><label><%= t('common.username') %></label><input type="text" name="username" value="<%= editUser.username %>" required></div>          <div class="form-group"><label><%= t('common.email') %></label><input type="email" name="email" value="<%= editUser.email %>" required></div>        </div>        <div class="grid-2">          <div class="form-group"><label><%= t('admin.userEdit.newPasswordLabel') %></label><input type="password" name="password" placeholder="<%= t('common.passwordPlaceholder') %>"></div>          <div class="form-group">            <label>&nbsp;</label>            <label class="checkbox-label"><span class="checkbox"><input type="checkbox" name="root_admin" <%= editUser.root_admin ? 'checked' : '' %>><span class="checkbox-mark"></span></span> <%= t('common.rootAdministrator') %></label>          </div>        </div>        <button type="submit" class="btn btn-primary"><%= t('common.saveChanges') %></button>      </div>    </form>    <% if (servers.length > 0) { %>      <div class="card" style="margin-bottom:20px">        <h3 style="font-size:16px;font-weight:600;margin-bottom:16px"><%= t('admin.userEdit.serversCount', { count: servers.length }) %></h3>        <div style="display:flex;flex-direction:column;gap:8px">          <% servers.forEach(s => { %>            <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)">              <div><a href="/admin/servers/<%= s.id %>" style="font-weight:600;color:var(--accent)"><%= s.name %></a> <span class="badge badge-<%= s.status === 'running' ? 'green' : status === 'starting' ? 'yellow' : 'red' %>"><%= s.status %></span></div>              <span style="font-size:12px;color:var(--text-muted)"><%= t('admin.userEdit.serverResources', { memory: s.memory, disk: s.disk }) %></span>            </div>          <% }) %>        </div>      </div>    <% } else { %>      <div class="card" style="margin-bottom:20px"><div class="empty"><h3><%= t('admin.userEdit.emptyServersTitle') %></h3><p><%= t('admin.userEdit.emptyServersText') %></p></div></div>    <% } %>    <div class="card">      <h3 style="font-size:16px;font-weight:600;margin-bottom:16px"><%= t('admin.userEdit.apiKeysCount', { count: userApiKeys.length }) %></h3>      <% if (userApiKeys.length > 0) { %>        <table class="table">          <thead><tr><th><%= t('admin.userEdit.memoHeader') %></th><th><%= t('admin.userEdit.keyHeader') %></th><th><%= t('admin.userEdit.lastUsedHeader') %></th><th><%= t('admin.userEdit.createdHeader') %></th></tr></thead>          <tbody>            <% userApiKeys.forEach(k => { %>              <tr>                <td><%= k.memo || t('admin.userEdit.noMemo') %></td>                <td><code><%= k.token.slice(0, 12) %>...</code></td>                <td style="font-size:12px;color:var(--text-muted)"><%= k.last_used_at ? new Date(k.last_used_at).toLocaleDateString() : t('admin.userEdit.never') %></td>                <td style="font-size:12px;color:var(--text-muted)"><%= new Date(k.created_at).toLocaleDateString() %></td>              </tr>            <% }) %>          </tbody>        </table>      <% } else { %>        <div class="empty"><h3><%= t('admin.userEdit.emptyApiKeysTitle') %></h3><p><%= t('admin.userEdit.emptyApiKeysText') %></p></div>      <% } %>    </div>  </div></div></body></html>