<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="main-content">
  <div class="page-wrapper">
    <div class="page-header"><h1><%= t('admin.nodes.title') %></h1><p><%= t('admin.nodes.subtitle') %></p></div>
    <%- include('_tabs') %>
    <div style="display:flex;align-items:center;justify-content:space-between;margin:20px 0 16px">
      <div style="display:flex;align-items:center;gap:12px">
        <h3 style="font-size:16px"><%= t('admin.nodes.countTitle', { count: nodes.length }) %></h3>
        <div class="view-mode-switch">
          <button type="button" id="listViewBtn" class="btn btn-ghost btn-sm active" aria-pressed="true" aria-label="List view" title="List view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg>
          </button>
          <button type="button" id="gridViewBtn" class="btn btn-ghost btn-sm" aria-pressed="false" aria-label="Grid view" title="Grid view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          </button>
        </div>
      </div>
      <% if (locations.length === 0) { %>
        <a href="/admin/locations?notice=nolocations" class="btn btn-primary btn-sm"><%= t('admin.nodes.createTitle') %></a>
      <% } else { %>
        <button onclick="var o=document.getElementById('create-node-modal'); if(o){ o.classList.remove('closing'); requestAnimationFrame(function(){ o.classList.add('active'); });; }" class="btn btn-primary btn-sm"><%= t('admin.nodes.createTitle') %></button>
      <% } %>
    </div>
    <div id="nodeListView">
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th><%= t('common.id') %></th><th><%= t('common.name') %></th><th><%= t('common.fqdn') %></th><th><%= t('common.location') %></th><th><%= t('common.status') %></th><th><%= t('common.servers') %></th><th><%= t('common.allocations') %></th><th><%= t('common.memory') %></th><th><%= t('common.disk') %></th><th><%= t('common.cpu') %></th><th><%= t('common.actions') %></th></tr></thead>
        <tbody>
          <% nodes.forEach(n => { %>
            <tr>
              <td><%= n.id %></td>
              <td><a href="/admin/nodes/<%= n.id %>" style="color:var(--accent)"><%= n.name %></a></td>
              <td style="display:flex;align-items:center;gap:6px">
                <% if (n.scheme === 'https') { %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="flex-shrink:0" role="img" aria-label="<%= t('common.https') %>"><path d="M8 10V7a4 4 0 018 0v3" stroke="var(--green, #22c55e)" stroke-width="2" stroke-linecap="round"/><rect x="4" y="10" width="16" height="11" rx="2.5" fill="var(--green, #22c55e)"/><circle cx="12" cy="15.5" r="1.4" fill="#ffffff"/></svg>
                <% } else { %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="flex-shrink:0" role="img" aria-label="<%= t('common.http') %>"><path d="M8 10V7a4 4 0 018 0" stroke="var(--red, #ef4444)" stroke-width="2" stroke-linecap="round"/><rect x="4" y="10" width="16" height="11" rx="2.5" fill="var(--red, #ef4444)"/><circle cx="12" cy="15.5" r="1.4" fill="#ffffff"/></svg>
                <% } %>
                <%= n.fqdn %>
                <% if (n.daemon_type === 'oxlify') { %><img src="/public/img/oxlify.png" alt="oxlify" style="height:18px;margin-left:6px"><% } else { %><img src="/public/img/rubityle.png" alt="rubityle" style="height:18px;margin-left:6px"><% } %>
              </td>
              <td><%= n.location_name || t('common.na') %></td>
              <td style="text-align:center;vertical-align:middle;padding:2px 0">
                <% if (n.online) { %>
                  <svg class="ecg-svg" width="18" height="14" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="color:#22c55e;display:inline-block;margin:0;vertical-align:middle;position:relative;left:-6px">
                    <defs>
                      <clipPath id="heart-clip-<%= n.id %>">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                      </clipPath>
                    </defs>
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" stroke="currentColor" stroke-width="1.5"/>
                    <g clip-path="url(#heart-clip-<%= n.id %>)">
                      <polyline points="-4,11 4,11 6,8 8,14 10,11 28,11" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="ecg-line"></polyline>
                    </g>
                  </svg>
                <% } else { %>
                  <svg class="ecg-svg" width="18" height="14" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="color:#ef4444;display:inline-block;margin:0;vertical-align:middle;position:relative;left:-6px">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" stroke="currentColor" stroke-width="1.5"/>
                    <text x="12" y="13" font-size="8" font-weight="700" text-anchor="middle" fill="white">!</text>
                  </svg>
                <% } %>
              </td>
              <td><%= n.server_count %></td>
              <td><%= n.allocation_count %></td>
              <td><%= t('admin.nodes.memoryGb', { memory: (Math.round(n.memory / 1024 * 10) / 10) }) %></td>
              <td><%= t('admin.nodes.diskCell', { disk: n.disk }) %></td>
              <td><%= t('admin.nodes.cpuFormat', { cpu: n.cpu }) %></td>
              <td style="display:flex;gap:6px">
                <a href="/admin/nodes/<%= n.id %>" class="btn btn-ghost btn-sm"><%= t('common.manage') %></a>
                <form method="POST" action="/admin/nodes/<%= n.id %>/delete" data-confirm="<%= t('admin.nodes.deleteConfirm') %>"><button class="btn btn-danger btn-sm"><%= t('common.delete') %></button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    </div>
    <div id="nodeGridView" class="node-grid" style="display:none">
      <% nodes.forEach(n => { %>
        <div class="node-card">
          <div class="node-card-header">
            <div style="min-width:0">
              <div class="node-card-title"><a href="/admin/nodes/<%= n.id %>"><%= n.name %></a></div>
              <div class="node-card-address">
                <% if (n.scheme === 'https') { %>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="flex-shrink:0" role="img" aria-label="<%= t('common.https') %>"><path d="M8 10V7a4 4 0 018 0v3" stroke="var(--green, #22c55e)" stroke-width="2" stroke-linecap="round"/><rect x="4" y="10" width="16" height="11" rx="2.5" fill="var(--green, #22c55e)"/><circle cx="12" cy="15.5" r="1.4" fill="#ffffff"/></svg>
                <% } else { %>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="flex-shrink:0" role="img" aria-label="<%= t('common.http') %>"><path d="M8 10V7a4 4 0 018 0" stroke="var(--red, #ef4444)" stroke-width="2" stroke-linecap="round"/><rect x="4" y="10" width="16" height="11" rx="2.5" fill="var(--red, #ef4444)"/><circle cx="12" cy="15.5" r="1.4" fill="#ffffff"/></svg>
                <% } %>
                <span class="node-card-fqdn"><%= n.fqdn %></span>
              </div>
            </div>
            <div class="node-card-aside">
              <span class="node-card-status <%= n.online ? 'is-online' : 'is-offline' %>" title="<%= n.online ? t('common.online') : t('common.offline') %>">
                <span class="node-status-dot"></span><%= n.online ? t('common.online') : t('common.offline') %>
              </span>
              <div class="node-card-daemon">
                <% if (n.daemon_type === 'oxlify') { %><img src="/public/img/oxlify.png" alt="oxlify"><% } else { %><img src="/public/img/rubityle.png" alt="rubityle"><% } %>
                <span class="node-card-daemon-name"><%= n.daemon_type === 'oxlify' ? t('common.oxlify') : t('common.rubityle') %></span>
              </div>
            </div>
          </div>
          <div class="node-card-details">
            <div class="node-card-row"><span class="label"><%= t('common.location') %></span><span class="value"><%= n.location_name || t('common.na') %></span></div>
            <div class="node-card-row"><span class="label"><%= t('common.servers') %></span><span class="value"><%= n.server_count %></span></div>
            <div class="node-card-row"><span class="label"><%= t('common.allocations') %></span><span class="value"><%= n.allocation_count %></span></div>
            <div class="node-card-row"><span class="label"><%= t('common.memory') %></span><span class="value"><%= t('admin.nodes.memoryGb', { memory: (Math.round(n.memory / 1024 * 10) / 10) }) %></span></div>
            <div class="node-card-row"><span class="label"><%= t('common.disk') %></span><span class="value"><%= t('admin.nodes.diskCell', { disk: n.disk }) %></span></div>
            <div class="node-card-row"><span class="label"><%= t('common.cpu') %></span><span class="value"><%= t('admin.nodes.cpuFormat', { cpu: n.cpu }) %></span></div>
          </div>
          <div class="node-card-actions">
            <a href="/admin/nodes/<%= n.id %>" class="btn btn-ghost btn-sm"><%= t('common.manage') %></a>
            <form method="POST" action="/admin/nodes/<%= n.id %>/delete" data-confirm="<%= t('admin.nodes.deleteConfirm') %>"><button class="btn btn-danger btn-sm"><%= t('common.delete') %></button></form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<div class="modal-overlay" id="create-node-modal">
  <div class="modal" style="max-width:600px">
    <button class="modal-close" onclick="var o=this.closest('.modal-overlay'); if(o){ o.classList.add('closing'); setTimeout(function(){ o.classList.remove('active'); o.classList.remove('closing'); }, 300); }">&times;</button>
    <h3><%= t('admin.nodes.createTitle') %></h3>
    <form method="POST" action="/admin/nodes/create" id="create-node-form">
      <div class="grid-2">
        <div class="form-group"><label><%= t('common.name') %></label><input type="text" name="name" required></div>
        <div class="form-group"><label><%= t('common.location') %></label><select name="location_id"><% locations.forEach(l => { %><option value="<%= l.id %>"><%= l.long %></option><% }) %></select></div>
      </div>
      <div class="grid-2">
        <div class="form-group"><label><%= t('common.fqdn') %></label><input type="text" name="fqdn" id="n-fqdn" placeholder="<%= t('admin.nodes.fqdnPlaceholder') %>" required></div>
        <div class="form-group"><label><%= t('common.scheme') %></label><select name="scheme" id="n-scheme"><option value="http"><%= t('common.http') %></option><option value="https"><%= t('common.https') %></option></select></div>
      </div>
      <div class="grid-3">
        <div class="form-group"><label><%= t('common.memoryMb') %></label><input type="number" name="memory" value="8192"></div>
        <div class="form-group"><label><%= t('common.cpuVcores') %></label><input type="number" name="cpu" value="8"></div>
        <div class="form-group"><label><%= t('common.diskGb') %></label><input type="number" name="disk" value="100"></div>
      </div>
      <p style="font-size:12px;color:var(--text-muted);margin:-8px 0 16px"><%= t('admin.nodes.placeholderNote') %></p>
      <div class="grid-2">
        <div class="form-group"><label><%= t('common.memoryOverallocate') %></label><input type="number" name="memory_overallocate" value="0"></div>
        <div class="form-group"><label><%= t('common.diskOverallocate') %></label><input type="number" name="disk_overallocate" value="0"></div>
      </div>
      <div class="grid-2">
        <div class="form-group"><label><%= t('common.daemonToken') %></label><input type="text" name="daemon_token" id="n-token" placeholder="<%= t('admin.nodes.tokenPlaceholder') %>"></div>
        <div class="form-group"><label><%= t('common.daemonListen') %></label><input type="text" name="daemon_listen" id="n-listen" value="8080"></div>
      </div>
      <div class="grid-2">
        <div class="form-group"><label><%= t('common.daemonType') %></label><select name="daemon_type"><option value="rubityle"><%= t('common.rubityle') %></option><option value="oxlify"><%= t('common.oxlify') %></option></select></div>
        <div class="form-group"><label><%= t('common.sftpPort') %></label><input type="number" name="sftp_port" id="n-sftp-port" value="2022"></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="var o=this.closest('.modal-overlay'); if(o){ o.classList.add('closing'); setTimeout(function(){ o.classList.remove('active'); o.classList.remove('closing'); }, 300); }"><%= t('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= t('admin.nodes.createTitle') %></button>
      </div>
    </form>
  </div>
</div>
<style>
.view-mode-switch {
  display: inline-flex;
  gap: 2px;
  padding: 3px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  border-radius: 8px;
}
.view-mode-switch .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 9px;
  border: none;
  background: transparent;
  color: var(--text-muted);
}
.view-mode-switch .btn svg { display: block; }
.view-mode-switch .btn:hover {
  background: var(--surface-hover);
  color: var(--text);
}
.view-mode-switch .btn.active {
  background: var(--accent);
  color: #fff;
}
.node-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
.node-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 18px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: border-color 0.2s ease;
}
.node-card:hover {
  border-color: rgba(var(--accent-r), var(--accent-g), var(--accent-b), 0.3);
}
.node-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.node-card-aside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  flex-shrink: 0;
}
.node-card-title {
  font-size: 17px;
  font-weight: 600;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.node-card-title a { color: var(--accent); }
.node-card-address {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  min-width: 0;
}
.node-card-fqdn {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.node-card-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}
.node-card-status.is-online { color: #22c55e; }
.node-card-status.is-offline { color: #ef4444; }
.node-status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 6px 0 currentColor;
}
.node-card-daemon {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}
.node-card-daemon img {
  height: 14px;
  width: auto;
  flex-shrink: 0;
}
.node-card-daemon-name {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
}
.node-card-details {
  display: flex;
  flex-direction: column;
}
.node-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 7px 0;
  font-size: 13px;
  border-bottom: 1px solid var(--border);
}
.node-card-row:last-child { border-bottom: none; }
.node-card-row .label { color: var(--text-muted); }
.node-card-row .value {
  font-weight: 600;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.node-card-actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}
@media (max-width: 900px) {
  .node-grid { grid-template-columns: 1fr; }
}
</style>
<script>
(function () {
  var listBtn = document.getElementById('listViewBtn');
  var gridBtn = document.getElementById('gridViewBtn');
  var listView = document.getElementById('nodeListView');
  var gridView = document.getElementById('nodeGridView');
  if (!listBtn || !gridBtn || !listView || !gridView) return;

  function setView(mode) {
    var grid = mode === 'grid';
    listView.style.display = grid ? 'none' : '';
    gridView.style.display = grid ? '' : 'none';
    listBtn.classList.toggle('active', !grid);
    gridBtn.classList.toggle('active', grid);
    listBtn.setAttribute('aria-pressed', String(!grid));
    gridBtn.setAttribute('aria-pressed', String(grid));
    try { localStorage.setItem('pylox.nodesView', mode); } catch (e) {}
  }

  listBtn.addEventListener('click', function () { setView('list'); });
  gridBtn.addEventListener('click', function () { setView('grid'); });

  var saved = null;
  try { saved = localStorage.getItem('pylox.nodesView'); } catch (e) {}
  if (saved === 'grid' || saved === 'list') setView(saved);
})();
</script>
</body></html>


