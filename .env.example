# Pylox Panel Configuration
NODE_ENV=production
APP_PORT=7956
APP_URL=http://localhost:7956
APP_KEY=change-me-to-a-random-32-char-string!!

# Database
# DB_DRIVER: "sqlite" (default, fast, file-based) or "mysql" (shared, networked)
DB_DRIVER=sqlite

# SQLite settings (used when DB_DRIVER=sqlite)
DB_PATH=./data/panel.db

# MySQL settings (used when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pylox
DB_PASSWORD=change-me
DB_NAME=pylox
DB_CONNECT_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000

# Session
SESSION_SECRET=change-me-to-another-random-string

# Daemon
DAEMON_SECRET=change-me-daemon-secret-key
DAEMON_URL=http://localhost:8080

# Docker
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=pylox-servers

# File Upload
MAX_UPLOAD_SIZE=100
